@model List<SmartGrocer.Models.Shop>
@{
    ViewData["Title"] = "My Shops";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0">My Registered Shops</h4>
    <a href="/Owner/ShopProfile" class="btn btn-gradient px-4">
        <i class="fas fa-plus-circle me-2"></i>Register New Shop
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Info"] != null)
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        @TempData["Info"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row">
    @if (!Model.Any())
    {
        <div class="col-12">
            <div class="card p-5 text-center">
                <i class="fas fa-store-slash fa-4x text-light mb-3"></i>
                <h5>No shops registered yet.</h5>
                <p class="text-secondary">Start by registering your first grocery shop.</p>
                <div class="mt-3">
                    <a href="/Owner/ShopProfile" class="btn btn-gradient">Register Now</a>
                </div>
            </div>
        </div>
    }
    @foreach (var shop in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100 position-relative">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <h5 class="card-title fw-bold mb-0">@shop.ShopName</h5>
                        @if (shop.Status == SmartGrocer.Models.UserStatus.Approved)
                        {
                            <span class="badge bg-success">Approved</span>
                        }
                        else if (shop.Status == SmartGrocer.Models.UserStatus.Pending)
                        {
                            <span class="badge bg-warning text-dark">Pending</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">@shop.Status</span>
                        }
                    </div>
                    <p class="card-text text-secondary small">
                        <i class="fas fa-map-marker-alt me-2"></i>@shop.Location
                    </p>
                </div>
                <div class="card-footer bg-transparent border-0 d-flex gap-2 pb-3">
                    @if (shop.Status == SmartGrocer.Models.UserStatus.Approved)
                    {
                        <a href="/Owner/SelectShop/@shop.ShopId" class="btn btn-sm btn-gradient flex-grow-1">Manage</a>
                    }
                    else
                    {
                        <button class="btn btn-sm btn-secondary flex-grow-1" disabled>Manage</button>
                    }
                    <a href="/Owner/ShopProfile/@shop.ShopId" class="btn btn-sm btn-outline-info">
                        <i class="fas fa-edit"></i>
                    </a>
                </div>
            </div>
        </div>
    }
</div>
