@model List<SmartGrocer.Models.Product>
@{
    ViewData["Title"] = "Shop Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0">Dashboard: <span class="text-gradient fw-bold">@ViewBag.CurrentShopName</span></h4>
    <a href="/Owner/MyShops" class="btn btn-outline-primary btn-sm px-3">
        <i class="fas fa-exchange-alt me-1"></i> Switch Shop
    </a>
</div>

<div class="row mt-4">
    <div class="col-md-3 mb-4">
        <div class="card p-4">
            <h6 class="text-secondary">TOTAL SALES</h6>
            <h2 class="text-gradient fw-bold">₹@ViewBag.TotalSales</h2>
            <div class="mt-2 small text-success"><i class="fas fa-arrow-up"></i> Lifetime Revenue</div>
        </div>
    </div>
    <div class="col-md-3 mb-4">
        <div class="card p-4">
            <h6 class="text-secondary">TOTAL PROFIT</h6>
            <h2 class="text-success fw-bold">₹@ViewBag.TotalProfit</h2>
            <div class="mt-2 small text-success"><i class="fas fa-chart-line"></i> Net Earnings</div>
        </div>
    </div>
    <div class="col-md-3 mb-4">
        <div class="card p-4 @(ViewBag.LowStockCount > 0 ? "border-danger" : "")">
            <h6 class="text-secondary">LOW STOCK ALERTS</h6>
            <h2 class="@(ViewBag.LowStockCount > 0 ? "text-danger" : "text-gradient") fw-bold">@ViewBag.LowStockCount</h2>
            <div class="mt-2 small">Products under 10 qty</div>
        </div>
    </div>
    <div class="col-md-3 mb-4">
        <div class="card p-4">
            <h6 class="text-secondary">TOTAL PRODUCTS</h6>
            <h2 class="text-gradient fw-bold">@ViewBag.TotalProducts</h2>
            <div class="mt-2 small">Inventory Variety</div>
        </div>
    </div>
</div>

@if (Model.Any())
{
    <div class="row">
        <div class="col-md-8">
            <div class="card p-4 mt-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="mb-0"><i class="fas fa-chart-line me-2 text-success"></i> Profit Performance</h5>
                    <select id="chartFilter" class="form-select form-select-sm w-auto bg-dark text-white border-secondary">
                        <option value="monthly" selected>Monthly View (Days)</option>
                        <option value="yearly">Yearly View (Months)</option>
                    </select>
                </div>
                <div id="chartNoData" class="d-none text-center py-5 text-secondary">
                    <i class="fas fa-chart-pie fa-3x mb-3 opacity-50"></i>
                    <h6>No data available yet</h6>
                    <small>Record a sale to see profit metrics</small>
                </div>
                <canvas id="monthlySalesChart" style="max-height: 300px;"></canvas>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card p-4 mt-4 border-danger">
                <h5 class="text-danger mb-4"><i class="fas fa-exclamation-triangle"></i> Low Stock</h5>
                <div class="table-responsive">
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>PRODUCT</th>
                                <th>QTY</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model)
                            {
                                <tr>
                                    <td>@p.Name</td>
                                    <td><span class="badge bg-danger">@p.Quantity left</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <a href="/Owner/Products" class="btn btn-sm btn-outline-danger w-100 mt-2">Update Stock</a>
            </div>
        </div>
    </div>
}
else
{
    <div class="card p-4 mt-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h5 class="mb-0"><i class="fas fa-chart-line me-2 text-success"></i> Profit Performance</h5>
            <select id="chartFilter" class="form-select form-select-sm w-auto bg-dark text-white border-secondary">
                <option value="monthly" selected>Monthly View (Days)</option>
                <option value="yearly">Yearly View (Months)</option>
            </select>
        </div>
        <div id="chartNoData" class="d-none text-center py-5 text-secondary">
            <i class="fas fa-chart-pie fa-3x mb-3 opacity-50"></i>
            <h6>No data available yet</h6>
            <small>Record a sale to see profit metrics</small>
        </div>
        <canvas id="monthlySalesChart" style="max-height: 300px;"></canvas>
    </div>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const ctx = document.getElementById('monthlySalesChart');
            if(!ctx) return;
            const context2d = ctx.getContext('2d');
            let profitChart = null;

            function loadChartData(filter) {
                fetch(`/Owner/GetChartData?filter=${filter}`)
                    .then(response => response.json())
                    .then(data => {
                        const noDataIndicator = document.getElementById('chartNoData');
                        
                        if (!data.labels || data.labels.length === 0) {
                            noDataIndicator.classList.remove('d-none');
                            ctx.classList.add('d-none');
                            if (profitChart) {
                                profitChart.destroy();
                                profitChart = null;
                            }
                            return;
                        }

                        noDataIndicator.classList.add('d-none');
                        ctx.classList.remove('d-none');

                        if (profitChart) {
                            profitChart.data.labels = data.labels;
                            profitChart.data.datasets[0].data = data.values;
                            profitChart.update(); 
                        } else {
                            profitChart = new Chart(context2d, {
                                type: 'line',
                                data: {
                                    labels: data.labels,
                                    datasets: [{
                                        label: 'Profit',
                                        data: data.values,
                                        borderColor: '#00d2ff',
                                        backgroundColor: 'rgba(0, 210, 255, 0.1)',
                                        borderWidth: 3,
                                        tension: 0.4,
                                        fill: true,
                                        pointBackgroundColor: '#3a7bd5',
                                        pointRadius: 5,
                                        pointHoverRadius: 7
                                    }]
                                },
                                options: {
                                    responsive: true,
                                    maintainAspectRatio: false,
                                    animation: {
                                        duration: 800,
                                        easing: 'easeOutQuart'
                                    },
                                    interaction: {
                                        mode: 'index',
                                        intersect: false,
                                    },
                                    scales: {
                                        y: {
                                            beginAtZero: true,
                                            grid: { color: 'rgba(255,255,255,0.05)' },
                                            ticks: { color: '#e0e0e0' }
                                        },
                                        x: {
                                            grid: { display: false },
                                            ticks: { color: '#e0e0e0' }
                                        }
                                    },
                                    plugins: {
                                        legend: { display: false },
                                        tooltip: {
                                            enabled: true,
                                            backgroundColor: 'rgba(0,0,0,0.8)',
                                            titleColor: '#fff',
                                            bodyColor: '#00d2ff',
                                            borderColor: '#444',
                                            borderWidth: 1,
                                            callbacks: {
                                                label: function(context) {
                                                    let val = context.parsed.y;
                                                    return 'Profit: ₹' + val.toLocaleString('en-IN');
                                                }
                                            }
                                        }
                                    }
                                }
                            });
                        }
                    })
                    .catch(error => console.error('Error fetching chart data:', error));
            }

            const filterSelect = document.getElementById('chartFilter');
            if (filterSelect) {
                filterSelect.addEventListener('change', function(e) {
                    loadChartData(e.target.value);
                });
            }

            // Load initial chart data
            loadChartData('monthly');
        });
    </script>
}
