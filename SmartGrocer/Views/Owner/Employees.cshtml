@model List<SmartGrocer.Models.User>
@{
    ViewData["Title"] = "My Shop Employees";
}

<div class="card p-4">
    <h5 class="mb-4">Employee Management</h5>
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>NAME</th>
                    <th>EMAIL</th>
                    <th>STATUS</th>
                    <th>ACTIONS</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center py-4">No employees registered for this shop.</td>
                    </tr>
                }
                @foreach (var emp in Model)
                {
                    <tr>
                        <td class="fw-bold">@emp.Name</td>
                        <td>@emp.Email</td>
                        <td>
                            @if (emp.Status == UserStatus.Pending)
                            {
                                <span class="badge bg-warning text-dark">Pending Approval</span>
                            }
                            else if (emp.Status == UserStatus.Approved)
                            {
                                <span class="badge bg-success">Approved</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Rejected</span>
                            }
                        </td>
                        <td>
                            <form asp-action="ProcessEmployee" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@emp.Id" />
                                @if (emp.Status == UserStatus.Pending)
                                {
                                    <button type="submit" name="action" value="Approve" class="btn btn-sm btn-success me-1">Approve</button>
                                    <button type="submit" name="action" value="Reject" class="btn btn-sm btn-outline-danger">Reject</button>
                                }
                                <button type="submit" name="action" value="Remove" class="btn btn-sm btn-danger ms-1" onclick="return confirm('Are you sure?')">Remove</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
