@model List<SmartGrocer.Models.Category>
@{
    ViewData["Title"] = "Manage Categories";
}

<div class="row">
    <div class="col-md-4">
        <div class="card p-4">
            <h5 class="mb-4">Add New Category</h5>
            <form asp-action="AddCategory" method="post">
                <div class="mb-3">
                    <label class="form-label">Category Name</label>
                    <input type="text" name="name" class="form-control" placeholder="e.g. Beverages" required />
                </div>
                <button type="submit" class="btn btn-gradient w-100">Add Category</button>
            </form>
        </div>
    </div>
    <div class="col-md-8">
        <div class="card p-4">
            <h5 class="mb-4">Existing Categories</h5>
            
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger py-2">@TempData["Error"]</div>
            }
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success py-2">@TempData["Success"]</div>
            }

            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>#ID</th>
                            <th>CATEGORY NAME</th>
                            <th>PRODUCTS</th>
                            <th>ACTION</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="3" class="text-center py-4">No categories added yet.</td>
                            </tr>
                        }
                        @foreach (var cat in Model)
                        {
                            <tr>
                                <td>@cat.Id</td>
                                <td class="fw-bold">@cat.Name</td>
                                <td><span class="badge bg-secondary">@cat.Products?.Count() Items</span></td>
                                <td>
                                    <form asp-action="DeleteCategory" asp-route-id="@cat.Id" method="post" style="display:inline;" id="deleteCategory-@cat.Id">
                                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="confirmDelete(@cat.Id)">
                                            <i class="fas fa-trash"></i> Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    function confirmDelete(id) {
        if (confirm("Step 1: Are you sure you want to delete this category? All associated products will also be deleted!")) {
            if (confirm("Step 2: This action is PERMANENT. Final confirmation - Delete category?")) {
                document.getElementById('deleteCategory-' + id).submit();
            }
        }
    }
</script>
