@model List<SmartGrocer.Models.Product>
@{
    ViewData["Title"] = "Inventory Management";
    var categories = (List<SmartGrocer.Models.Category>)ViewBag.Categories;
}

<div class="row">
    <div class="col-md-4">
        <div class="card p-4">
            <h5 class="mb-4">Add New Product</h5>
            <form asp-action="AddProduct" method="post">
                <div class="mb-3">
                    <label class="form-label">Product Name</label>
                    <input type="text" name="Name" class="form-control" placeholder="e.g. Rice 5kg" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Category</label>
                    <select name="CategoryId" class="form-control" required>
                        <option value="">Select Category</option>
                        @foreach (var cat in categories)
                        {
                            <option value="@cat.Id">@cat.Name</option>
                        }
                    </select>
                </div>
                <div class="row">
                    <div class="col-6 mb-3">
                        <label class="form-label">Purchase Price</label>
                        <input type="number" step="0.01" name="PurchasePrice" class="form-control" placeholder="0.00" required />
                    </div>
                    <div class="col-6 mb-3">
                        <label class="form-label">Selling Price</label>
                        <input type="number" step="0.01" name="SellingPrice" class="form-control" placeholder="0.00" required />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Initial Quantity</label>
                    <input type="number" name="Quantity" class="form-control" placeholder="Enter stock count" required />
                </div>
                <button type="submit" class="btn btn-gradient w-100">Save Product</button>
            </form>
        </div>
    </div>
    <div class="col-md-8">
        <div class="card p-4">
            <h5 class="mb-4">Shop Inventory</h5>
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>PRODUCT</th>
                            <th>CATEGORY</th>
                            <th>PURCHASE</th>
                            <th>SELLING</th>
                            <th>STOCK</th>
                            <th>STATUS</th>
                            <th>ACTION</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4">No products in inventory.</td>
                            </tr>
                        }
                        @foreach (var p in Model)
                        {
                            <tr>
                                <td class="fw-bold">@p.Name</td>
                                <td><span class="badge bg-secondary">@p.Category?.Name</span></td>
                                <td>₹@p.PurchasePrice</td>
                                <td class="text-info">₹@p.SellingPrice</td>
                                <td>@p.Quantity</td>
                                <td>
                                    @if (p.Quantity < 10)
                                    {
                                        <span class="badge bg-danger">Low Stock</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Available</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex gap-2">
                                        <button type="button" class="btn btn-sm btn-outline-info" data-bs-toggle="modal" data-bs-target="#updateModal-@p.Id" title="Update Stock">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <form asp-action="DeleteProduct" asp-route-id="@p.Id" method="post" onsubmit="return confirm('Delete this product permanently?')">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Product">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>

                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@foreach(var p in Model)
{
    <!-- Update Stock Modal (Top Level to prevent Bootstrap Z-index table bugs) -->
    <div class="modal fade" id="updateModal-@p.Id" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-dark border-secondary shadow-lg">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title text-white">Update Stock: @p.Name</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-action="UpdateProductStock" method="post">
                    <input type="hidden" name="id" value="@p.Id" />
                    <div class="modal-body text-start">
                        <div class="mb-3">
                            <label class="form-label text-white">Current Stock: @p.Quantity</label>
                            <input type="number" name="newQuantity" class="form-control bg-secondary text-white border-0" value="@p.Quantity" min="0" required />
                            <div class="form-text text-light mt-2">Specify the exact new total quantity for this stock item.</div>
                        </div>
                    </div>
                    <div class="modal-footer border-secondary">
                        <button type="button" class="btn btn-secondary text-white" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-info text-white">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
