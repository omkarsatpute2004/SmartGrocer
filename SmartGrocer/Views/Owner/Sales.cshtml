@model List<SmartGrocer.Models.Sale>
@{
    ViewData["Title"] = "Record Sales";
    var products = (List<SmartGrocer.Models.Product>)ViewBag.Products;
}

<div class="row">
    <div class="col-md-4">
        <div class="card p-4">
            <h5 class="mb-4">New Transaction</h5>
            
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger py-2">@TempData["Error"]</div>
            }
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success py-2">@TempData["Success"]</div>
            }

            <form asp-action="RecordSale" method="post">
                <div class="mb-3">
                    <label class="form-label">Search Product</label>
                    <select name="productId" class="form-control" required>
                        <option value="">Select Product...</option>
                        @foreach (var p in products)
                        {
                            <option value="@p.Id">@p.Name (₹@p.SellingPrice - @p.Quantity left)</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Quantity</label>
                    <input type="number" name="quantity" class="form-control" min="1" placeholder="Qty" required />
                </div>
                <button type="submit" class="btn btn-gradient w-100">Submit Sale</button>
            </form>
        </div>
    </div>
    <div class="col-md-8">
        <div class="card p-4">
            <h5 class="mb-4">Sales History</h5>
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>DATE</th>
                            <th>ITEM</th>
                            <th>QTY</th>
                            <th>TOTAL</th>
                            <th>PROFIT</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4">No sales records available.</td>
                            </tr>
                        }
                        @foreach (var s in Model)
                        {
                            <tr>
                                <td>@s.Date.ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="fw-bold">@s.Product?.Name</td>
                                <td>@s.Quantity</td>
                                <td class="text-info">₹@s.TotalAmount</td>
                                <td class="text-success">₹@s.Profit</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
