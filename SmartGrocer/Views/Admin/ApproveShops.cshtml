@model List<SmartGrocer.Models.Shop>
@{
    ViewData["Title"] = "Pending Shop Approvals";
}

<div class="card p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h5 class="mb-0">Pending Shop Registration Requests</h5>
        <span class="badge bg-warning text-dark px-3 py-2">@Model.Count Pending</span>
    </div>
    
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>SHOP NAME</th>
                    <th>LOCATION</th>
                    <th>OWNER</th>
                    <th>OWNER EMAIL</th>
                    <th>ACTIONS</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-5">
                            <i class="fas fa-check-circle text-success fa-3x mb-3"></i>
                            <p class="text-secondary">No pending shop registration requests.</p>
                        </td>
                    </tr>
                }
                @foreach (var shop in Model)
                {
                    <tr>
                        <td class="fw-bold">@shop.ShopName</td>
                        <td>@shop.Location</td>
                        <td>@shop.Owner.Name</td>
                        <td class="small text-secondary">@shop.Owner.Email</td>
                        <td>
                            <div class="d-flex gap-2">
                                <form asp-action="ProcessShop" method="post">
                                    <input type="hidden" name="id" value="@shop.ShopId" />
                                    <input type="hidden" name="action" value="Approve" />
                                    <button type="submit" class="btn btn-sm btn-success px-3">Approve</button>
                                </form>
                                <form asp-action="ProcessShop" method="post" onsubmit="return confirm('Reject this shop?');">
                                    <input type="hidden" name="id" value="@shop.ShopId" />
                                    <input type="hidden" name="action" value="Reject" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger px-3">Reject</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
